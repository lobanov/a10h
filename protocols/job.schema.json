{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://autoresearch.dev/protocols/job.schema.json",
  "title": "Job spec",
  "type": "object",
  "required": ["id", "image", "command", "requirements"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$" },
    "activity": { "type": "string" },
    "plan_id": { "type": "string" },
    "image": { "type": "string", "minLength": 1, "description": "Advisory stack declaration (e.g. python:3.12-slim). Workers host workloads as subprocesses; the worker image must carry the runtimes it serves, matched via node capability tags." },
    "command": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gpu": { "type": "boolean", "default": false },
        "cpu": { "type": "number", "minimum": 0 },
        "mem": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence": { "type": "array", "items": { "type": "string" } },
        "artifacts": { "type": "array", "items": { "type": "string" } }
      }
    },
    "inputs_evidence": {
      "type": "array",
      "description": "Upstream activities' evidence materialized into the checkout pre-run (hub-populated).",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": { "path": { "type": "string" }, "content": { "type": "string" } }
      }
    },
    "timeout_s": { "type": "number", "minimum": 1 },
    "attempt": { "type": "integer", "minimum": 1, "default": 1 }
  }
}
