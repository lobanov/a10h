# Pi Autoresearch Lab — hub/worker configuration
# Copy to .env (never commit .env). Only the hub needs most of these.

# --- required: hub ---
# Token for dashboard/API auth. Leave empty to disable auth (LAN/demo only).
AUTH_TOKEN=

# Postgres (hub). The compose default matches the postgres service.
POSTGRES_USER=autoresearch
POSTGRES_PASSWORD=autoresearch-dev          # CHANGE FOR ANY NON-LOCAL USE
POSTGRES_DB=autoresearch

# Path to the framework repo as seen by the hub container (mounted read-only).
# Used to serve the dashboard and (optionally) read protocol specs.
REPO_PATH=/repo

# --- required: worker (runner) ---
# Hub base URL as seen from the worker container.
HUB_URL=http://hub:8080
# Node id + capability tags (comma-separated key[:value]) advertised to the hub.
NODE_ID=worker-a
NODE_TAGS=cpu:4,mem:8G
# Path to the research project repo (or framework repo containing
# examples/demo-project) as seen from the worker container. Job checkouts are
# created from this repo; workloads run as subprocesses in the checkout dir.
REPO_PATH=/repo
# Checkout strategy per job: worktree (shared .git) or clone (isolated copy).
CHECKOUT_STRATEGY=clone
# Where per-job checkouts live (inside the worker container).
WORK_DIR=/work
# Per-job env passthrough: JOB_ENV_FOO=bar reaches workloads as FOO=bar.
# Workloads otherwise run with a minimal env (PATH, HOME=/tmp, LANG).
# SECURITY: no docker socket is mounted — workers host workloads as
# subprocesses inside their own container, so a compromised workload cannot
# reach the host. The worker image must carry the runtimes it serves.
# JOB_ENV_HTTP_PROXY=

# --- optional: agent inference (M5) ---
# Provider keys for agent roles. Direct provider use; LiteLLM optional below.
Z_AI_API_KEY=
Z_AI_BASE_URL=https://api.z.ai/api/coding/paas/v4
# Local vLLM auditor (compose --profile local-llm). Point the hub at the
# compose-internal service URL and the model id served by vLLM.
LOCAL_LLM_BASE_URL=http://llamacpp:8000/v1
LOCAL_LLM_API_KEY=
LOCAL_LLM_MODEL=gemma-4-26b-it
# Role models: auditor on local gemma (vLLM), director on GLM-5.3 (per policy).
AUDITOR_MODEL=local/gemma-4-26b-it
DIRECTOR_MODEL=z.ai/glm-5.3
# Role -> model tier mapping lives in each project's config/project.yaml.
# Model weights (local-llm profile):
#   ./data/vllm-models/model/gemma-4-26B-A4B-it-UD-Q4_K_M.gguf  (scripts/fetch-models.sh)

# --- optional: LiteLLM gateway (compose --profile litellm) ---
LITELLM_MASTER_KEY=
